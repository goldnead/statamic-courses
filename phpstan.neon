includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - src
        - database
        - config

    # entitlements is a `suggest`. It sits in require-dev, so the access
    # bridge is analysed against the real classes.

    # Implements statamic-private-media's MediaAccess, a `suggest` that is not
    # installed here; loaded only when that interface exists.
    excludePaths:
        - src/Integrations/CourseMediaAccess.php

    treatPhpDocTypesAsCertain: false

    # Larastan only knows the host app's config directory; this is the
    # package's own, where env() is exactly right.
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/courses.php
        # Older statamic/cms releases give the parent's $vite a narrower
        # docblock than the bundle array; newer ones do not. Tolerate both.
        -
            identifier: property.defaultValue
            path: src/ServiceProvider.php
            reportUnmatched: false
